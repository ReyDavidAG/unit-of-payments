# Copy to .env and fill in the anon key.
#   cp .env.example .env
#
# Both values live in the Supabase dashboard under Project Settings > API.
# The anon key is public by design — it ships inside the app and is useless
# without a session, because RLS denies everything by default. The service_role
# key is NOT public and must never appear in this project.
#
# Read at compile time, not at runtime:
#   flutter run   --dart-define-from-file=.env
#   flutter build --dart-define-from-file=.env

SUPABASE_URL=https://ojyyvjkemkjcubsthmci.supabase.co
SUPABASE_ANON_KEY=
